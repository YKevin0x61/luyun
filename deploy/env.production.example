# 生产环境变量示例。
#
# 用法：
#   cp deploy/env.production.example deploy/env.production
#   vim deploy/env.production   # 填入真实值
#   # 不要把 deploy/env.production 提交到 git（只提交这份 .example）
#
# 本文件里的字段名对应 config.py 的 Settings 类字段（pydantic-settings，
# case_sensitive=True，字段名必须完全一致），systemd 通过 luyun.service 的
# EnvironmentFile= 加载；本地临时调试也可以 `set -a && source deploy/env.production
# && set +a` 后再跑 uvicorn。

# ── 基础 / 服务器配置 ──
DEBUG=false
# 只监听本机回环地址，对外访问统一经由 Caddy/Nginx 反向代理终结 TLS
# （见 deploy/Caddyfile、deploy/nginx.conf）。deploy/luyun.service 的 ExecStart
# 里已经直接写了 --host 127.0.0.1 --port 8000，这两个变量只在你选择用
# `python scripts/start.py` / `uvicorn main:app` 不带参数启动时才会生效。
HOST=127.0.0.1
PORT=8000
WORKERS=1

# ── 鉴权 ──
# ADMIN_API_KEY 是过渡期兼容字段（api/security.py 里会打 deprecated 警告），
# 生产环境建议留空，走 /login 网页登录（Session Cookie）或 api_token
# （services/auth_service.py 里管理的长期令牌）。
ADMIN_API_KEY=
# 是否允许「未完成任何账号初始化 + 无 ADMIN_API_KEY」时，来自 127.0.0.1/::1
# 的请求跳过鉴权直接调用写接口（仅用于本机首次 /setup 初始化）。
# 生产环境必须为 false —— 反向代理通常会让所有请求在后端看来都来自
# 127.0.0.1（X-Forwarded-For 之外的 socket 对端地址），若开着这个开关等于
# 对外网开放未授权写权限。首次初始化建议直接在部署机器上用
# `curl --unix-socket` 或临时把 HOST 改回仅本机场景测试，初始化完成后
# 再切到反向代理。
ALLOW_UNAUTH_SETUP_FROM_LOCALHOST=false
SESSION_COOKIE_NAME=luyun_session
SESSION_TTL_HOURS=8
SESSION_REMEMBER_DAYS=30
AUTH_MIN_PASSWORD_LENGTH=8
AUTH_MAX_PASSWORD_BYTES=1024

# ── 凭据加密密钥（services/credentials_store.py，不是 config.py Settings 字段，
#    直接读环境变量 LUYUN_CRED_KEY）──
# 用于加密 /setup 页面保存的 POS 登录账号密码（data/credentials.enc）。
# 留空时会自动生成一份并写入 data/.cred_key（仅本机可读，600 权限），首次部署
# 可以先不设置，让程序自动生成后再从 data/.cred_key 读出来固化到这里；一旦定下
# 来就不要再改，否则旧的 data/credentials.enc 会解密失败（需要重新走一次
# /setup）。生成一个新 key 的方式：
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LUYUN_CRED_KEY=

# ── 日志存储（services/log_storage.py）──
LOG_RETENTION_DAYS=7
LOG_QUEUE_BATCH_SIZE=200
LOG_QUEUE_FLUSH_INTERVAL=1.0

# ── 餐厅爬虫（scraper/adapter.py，POS 系统登录账号/密码走 /setup 页面维护，
#    加密存储在 data/credentials.enc，不在这里配置）──
# 注意：营业时段 / 轮询间隔 / headless / 重试次数已改由数据库运行配置管理
#      （app_settings 表，见 services/runtime_settings.py），在「配置 → 运行配置」
#      页面在线修改并热生效，不再通过环境变量配置。
RESTAURANT_BASE_URL=https://restaurant.sealosgzg.site

# ── 已结账单 / 对账 API ──
SETTLED_BILL_API_TIMEOUT_MS=30000
SETTLED_BILL_API_MAX_RETRIES=3
SETTLED_BILL_API_RETRY_BACKOFF_S=1.5
RECONCILE_MISS_RATE_ALERT_PCT=0.5
RECONCILE_MISS_QTY_ALERT=10.0
UNMAPPED_DISH_ALERT_ENABLED=true
UNMAPPED_ALERT_INTERVAL_HOURS=2
SCRAPER_ALERT_FAILURE_THRESHOLD=3
RECONCILE_SCHEDULE_ENABLED=false
RECONCILE_SCHEDULE_TIME=22:05
RECONCILE_AUTO_FIX=true
RECONCILE_AUTO_NOTIFY=true

# ── GitHub Release Version Check / Update Job（ADR 0011）──
# 仓库为公开仓。新机器请用 scripts/bootstrap_install.sh（或 Release 资产 install.sh）：
# 匿名下载并校验发行包即可；本文件也应 chmod 600。
# 仓库名默认写死在 config.py（YKevin0x61/luyun）；一般无需设 GITHUB_REPO。
# GITHUB_RELEASES_TOKEN 可选：公开仓可不填；仅在 API 限流时需要只读 PAT。
# Token 也可在 Admin「系统更新」页配置（data/github_release.enc）。
# Apply Update / Bootstrap 走发行包，不再需要 Deploy Key / 店内 .git。
#
# 部署模式（Apply Update 如何拉起作业 / 如何重启）：
#   systemd（默认/宿主机）：systemctl start --no-block luyun-update.service
#   docker（1Panel 等）：容器内后台跑 scripts/run_update_job.py，结束时经 docker.sock 重启容器
# LUYUN_DEPLOY_MODE=auto          # auto | docker | systemd
# LUYUN_DOCKER_CONTAINER=luyun
# LUYUN_DOCKER_SOCK=/var/run/docker.sock
# Docker / Compose 见 deploy/docker-compose.yml 与 ./scripts/docker_up.sh：
#   - 必须绑定挂载「应用目录的父目录」（默认 host ./runtime → /srv/luyun），
#     直播树为 /srv/luyun/app；Update Job 会在同卷上 rename app↔app.prev。
#   - 挂载 /var/run/docker.sock，并设置 LUYUN_DOCKER_CONTAINER=容器名
#   - 不要求挂载 .git；交付仍是发行包，不是 docker pull 镜像
#
# GITHUB_REPO=YKevin0x61/luyun
GITHUB_RELEASES_TOKEN=
# 部署目录；留空则使用代码所在应用根目录（Docker 下应设为 /srv/luyun/app）
RELEASE_UPDATE_REPO_DIR=

# ── 未在 config.py Settings 里、但代码里确实会读的环境变量（可选覆盖）──
# 配方库数据库路径（services/recipes/store.py），默认相对路径 data/recipes.db，
# 依赖进程 cwd = WorkingDirectory；一般不需要改，除非想把配方库单独放别处。
# RECIPES_DB_PATH=/opt/luyun/data/recipes.db

# ── 以下两项目前是硬编码，不支持环境变量覆盖，仅作说明，不要在这里配置 ──
# 1) CORS：main.py 里 CORSMiddleware 硬编码 allow_origins=["*"] +
#    allow_credentials=False（见 CLAUDE.md「Important Gotchas」）。反向代理
#    同源转发场景下浏览器不会触发跨域，无需关注；若之后要开放给其它域名的
#    前端调用，需要改代码而不是配置。
# 2) 营业时间：scraper/adapter.py 里硬编码 07:30-21:30（北京时间），
#    非营业时间自动暂停采集，暂不支持通过环境变量调整。

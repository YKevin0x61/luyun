# Copy to deploy/.env.docker (gitignored) and adjust before:
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env.docker up -d --build
# Or: ./scripts/docker_up.sh

# Host directory mounted as /srv/luyun (PARENT of live app).
# Live app will be <this>/app — do NOT point this at the app dir itself.
LUYUN_HOST_PARENT=./runtime

# Published host port → container 8000
LUYUN_HOST_PORT=8000

# Must match container_name (Update Job restarts this container via docker.sock)
LUYUN_DOCKER_CONTAINER=luyun

# Local image tag after build
LUYUN_DOCKER_IMAGE=luyun:local

# Public GitHub repo (optional PAT only for API rate limits)
GITHUB_REPO=YKevin0x61/luyun
GITHUB_RELEASES_TOKEN=

# First boot: download latest formal Release Bundle into runtime/app when empty
LUYUN_DOCKER_AUTO_BOOTSTRAP=1
# LUYUN_TAG=latest
